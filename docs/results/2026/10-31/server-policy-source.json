  "testFiles": [
    {
      "path": "tests/server-policy.test.mjs",
      "names": [
        "missing trusted ports fail closed and exposed capability ceilings never admit chat or dispatch",
        "admission requires a confirmed trusted principal rather than caller identity fields",
        "application sessions must match the verified handle subject and provider session independently",
        "revoked expired future-authenticated and overlong application sessions deny admission",
        "mutation integrity is checked with the verified handle while admitted reads remain available",
        "active organization and current membership rows are re-read after revocation and role changes",
        "the role and operation-kind matrix denies member viewer and administrator retirement paths",
        "foreign organization instance and operation identifiers return no cross-organization workspace",
        "provision and delete require Owner authentication within five minutes including the exact boundary",
        "bootstrap generates authoritative organization instance and Owner actor records in one audit",
        "stable bootstrap retries recover only the same principal request and name without another audit",
        "bootstrap replay cannot restore a revoked first Owner membership",
        "request self-review and separate confirmation retain one immutable plan hash across current CAS values",
        "stale server revisions generations and changed review hashes cannot mutate a current plan",
        "exact operation and terminal retries require current CAS and do not create duplicate audit records",
        "intent changes supersede active reviewed plans and identical intent saves add no audit",
        "CAS refusal and audit failure roll back the domain mutation and its server revision together",
        "independent serialized transactions permit one concurrent CAS winner and retain exactly one mutation audit",
        "public records and submitted audits are frozen detached data with server-only actor and minimal metadata",
        "strict caller records reject authority extras prototypes accessors and malformed targets without getter reads",
        "invitation plaintext appears only in its first private unbound delivery envelope and never the store or audit",
        "only a current Owner may invite or alter membership and no direct path can grant Owner",
        "invite acceptance binds the exact token and confirmed recipient email before any membership write",
        "expired revoked and inactive-issuer invitations cannot admit a recipient",
        "a matching invite creates only its specified organization role and returns an idempotent acknowledgment",
        "accepted token replay cannot restore revocation and re-admission needs a strictly newer invite",
        "invite acceptance cannot overwrite an active role and explicit role changes or revocation affect the next request",
        "the last active Owner cannot be demoted or revoked while removing an additional Owner is permitted",
        "Owner transfer changes both roles only on exact recipient acceptance and replay adds no audit",
        "Owner transfer rechecks recipient issuer role issuer session and five-minute authentication freshness",
        "membership invitation and two-role transfer effects roll back atomically when a later write or audit fails",
        "membership bodies retain current CAS exact foreign-target fences and acknowledgment-only responses"
      ]
    }
  ],
