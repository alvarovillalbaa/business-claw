  "testFiles": [
    {
      "path": "tests/domain.test.mjs",
      "names": [
        "new workspaces are detached frozen plans and never claim connected or ready infrastructure",
        "canonical JSON roundtrips one organization and accepts only data-only null-prototype records",
        "strict records and dense arrays reject unknown hidden symbol accessor and inherited fields",
        "ownership generation and revision validation reject transplanted and impossible records",
        "setup intents are exact bounded public settings and credential-like input fails with safe codes",
        "JSON imports reject malformed oversized unsafe schema and timestamp data without echoing it",
        "request identities are idempotent only for the same actor kind and immutable plan",
        "reviewed and confirmed workflow data produces only explicit unbound command proposals",
        "invalid transitions cannot skip review revise completed decisions or manufacture success",
        "cancellation preserves reviewed plans and removes proposals at every active workflow stage",
        "intent revisions supersede active plans while identical terminal retries remain harmless",
        "snapshot guards reject stale revisions generations and time before considering retries",
        "unverified observations remain non-authoritative and require owned targets valid links and times",
        "portable operation and observation history has explicit limits without dropping existing data"
      ]
    }
  ],
