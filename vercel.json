{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts --no-audit --no-fund",
  "buildCommand": "node scripts/check-source.mjs",
  "outputDirectory": "web",
  "functions": { "api/v1.mjs": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/v1?bc_route=:path*" }
  ]
}
